@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <base href="/" />
    <link rel="stylesheet" href="@Assets["BackseatDriver.Web.styles.css"]" />

    <title>Backseat Driver</title>
    <HeadOutlet @rendermode="@GlobalRenderMode" />
</head>

<body>

    <Routes @rendermode="@GlobalRenderMode"/>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static readonly IComponentRenderMode GlobalRenderMode = new InteractiveServerRenderMode(prerender: false);
}
