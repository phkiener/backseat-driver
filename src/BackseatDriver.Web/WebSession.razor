@using BackseatDriver.Core
@using BackseatDriver.Core.Abstractions
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@page "/"

<main>
    <ol>
        @foreach (var message in chatHistory)
        {
            <li>
                @if (message.AdditionalContent is not null)
                {
                    <details>
                        <summary>@(message.Sender): @(message.Content)</summary>
                        <p>@message.AdditionalContent</p>
                    </details>
                }
                else
                {
                    <span>@(message.Sender): @(message.Content)</span>
                }
            </li>
        }
    </ol>

    @switch (processing)
    {
        case true when currentTool is not null:
            <span>Invoking @currentTool...</span>
            break;

        case true:
            <span>Running...</span>
            break;

        default:
            <form @onsubmit="@SendMessage">
                <input type="text" @bind="currentMessage" placeholder="Prompt..." @ref="@textField">
                <button type="submit">Send</button>
            </form>

            break;
    }
</main>

@code {

    private sealed record HistoryEntry(string Sender, string Content, string? AdditionalContent);

    private readonly List<HistoryEntry> chatHistory = [];
    private bool processing = false;
    private string? currentTool = null;

    private ElementReference textField;
    private string currentMessage = "";

    [Inject]
    public required IModelSession ModelSession { get; set; }

    [Inject]
    public required IToolEngine ToolEngine { get; set; }


    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        ModelSession.OnMessageAdded += OnMessageReceived;
        ModelSession.OnProcessingStarted += OnSessionStatusChanged;
        ModelSession.OnProcessingCompleted += OnSessionStatusChanged;

        ToolEngine.OnToolStarted += OnToolStarted;
        ToolEngine.OnToolFinished += OnToolFinished;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!processing)
        {
            await textField.FocusAsync();
        }
    }

    private void OnMessageReceived(object? sender, IMessage? message)
    {
        if (message is Message.UserPrompt userPrompt)
        {
            chatHistory.Add(new("user", userPrompt.Content, null));
        }

        if (message is Message.AssistantResponse response)
        {
            chatHistory.Add(new("assistant", response.Content, response.Reasoning));
        }

        if (message is Message.ToolRequest toolRequest)
        {
            chatHistory.Add(new("assistant", toolRequest.Content, toolRequest.Reasoning));
        }

        if (message is Message.ToolResult result)
        {
            chatHistory.Add(new("tool", result.Content, null));
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnSessionStatusChanged(object? sender, EventArgs eventArgs)
    {
        processing = ModelSession.IsWorking;
        InvokeAsync(StateHasChanged);
    }

    private void OnToolStarted(object? sender, string? tool)
    {
        currentTool = tool;
        InvokeAsync(StateHasChanged);
    }

    private void OnToolFinished(object? sender, EventArgs eventArgs)
    {
        currentTool = null;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ModelSession.OnMessageAdded -= OnMessageReceived;
        ModelSession.OnProcessingStarted -= OnSessionStatusChanged;
        ModelSession.OnProcessingCompleted -= OnSessionStatusChanged;

        ToolEngine.OnToolStarted -= OnToolStarted;
        ToolEngine.OnToolFinished -= OnToolFinished;
    }

    private async void SendMessage(EventArgs eventArgs)
    {
        try
        {
            if (currentMessage is not "")
            {
                var prompt = new string(currentMessage);
                currentMessage = "";

                await Task.Factory.StartNew(() => ModelSession.SendAsync(prompt), TaskCreationOptions.LongRunning);
            }
        }
        catch
        {
            // Just ignore it.
        }
    }

}
